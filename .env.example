# ── Database (Supabase Postgres) ─────────────────────────────────────
# Supabase → Connect → "Session pooler" connection string, with your database
# password filled in. Leave empty to run on sample data that resets on restart.
DATABASE_URL=""

# ── Sign-in (Supabase Auth) ──────────────────────────────────────────
# Supabase → Project Settings → API Keys (or Connect → App frameworks).
# Leave both empty locally to skip the login screen; production requires them.
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────
# Full setup guide: docs/whatsapp-setup.md
# Leave the phone number ID or token empty to run in simulation mode.
# From your Meta App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Permanent System User token (not the temporary 24h dev token)
WHATSAPP_ACCESS_TOKEN=""
# Graph API version. v21.0 expires Jan 2027; v25.0 is supported until Jul 2028.
WHATSAPP_API_VERSION="v25.0"
# Meta App ID (App settings → Basic). Only needed to submit the photo/video
# invitation templates, which require a sample file uploaded to the app.
WHATSAPP_APP_ID=""
# People Nidaa may start conversations with per rolling 24h (Meta's messaging
# limit). 250 until business verification, then 2000 or higher, or "unlimited".
# Invitations past the limit are queued and sent automatically as room frees up.
WHATSAPP_DAILY_LIMIT="250"
# Language code the message templates are created and sent in
WHATSAPP_TEMPLATE_LANGUAGE="en"
# Token you choose; must match what you enter in the Meta webhook config
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# App Secret — used to verify the X-Hub-Signature-256 header on inbound webhooks
WHATSAPP_APP_SECRET=""

# ── Reminders cron ───────────────────────────────────────────────────
# Sent as "Authorization: Bearer <secret>" to /api/cron/reminders
CRON_SECRET=""

# ── App ──────────────────────────────────────────────────────────────
# Public URL; used to show the webhook callback URL in Settings.
# For local WhatsApp testing, set this to your ngrok/cloudflared HTTPS URL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Privacy policy (/privacy) ────────────────────────────────────────
# Shown on the public privacy page that Meta links to (App settings → Basic)
NIDAA_LEGAL_NAME=""
NIDAA_PRIVACY_EMAIL=""
